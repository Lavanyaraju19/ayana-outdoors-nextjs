# Copy to .env.local for local development (values below are for `supabase start`'s local stack —
# safe, publicly-documented defaults, not real secrets). For production/Hostinger, replace every
# value with the equivalent from your own hosted Supabase project (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# SERVER-ONLY. Never expose this to the browser or commit a real value — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Local-dev-only admin account created by `npm run db:seed:admin`. Not used in production —
# create real admin accounts via the Supabase dashboard or `supabase/scripts/create-admin.ts`.
DEV_ADMIN_EMAIL=admin@ayanaoutdoors.local
DEV_ADMIN_PASSWORD=AyanaLocalDev123!

# Optional. Enquiries are always saved to the database regardless of this being set — leaving it
# blank just means no notification email is sent. Get a key at https://resend.com if/when needed.
RESEND_API_KEY=
